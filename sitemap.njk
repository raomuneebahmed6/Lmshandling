{%- set categoryUrls = [
  { "slug": "lms-handling", "changefreq": "weekly", "priority": "0.7" },
  { "slug": "exam-preparation", "changefreq": "weekly", "priority": "0.7" },
  { "slug": "course-code-guides", "changefreq": "weekly", "priority": "0.7" },
  { "slug": "admissions", "changefreq": "weekly", "priority": "0.8" },
  { "slug": "final-year-project", "changefreq": "weekly", "priority": "0.7" },
  { "slug": "registration", "changefreq": "weekly", "priority": "0.7" }
] -%}
  <url>
    <loc>https://lmshandling.com/blog/</loc>
    <lastmod>{{ collections.blogMeta.maxDateModified }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  {% for post in collections.blogPosts -%}
  <url>
    <loc>https://lmshandling.com{{ post.url }}</loc>
    <lastmod>{{ post.dateModified }}</lastmod>
    <changefreq>{{ post.sitemapChangefreq }}</changefreq>
    <priority>{{ post.sitemapPriority }}</priority>
  </url>
  {% endfor %}
  {% for cat in categoryUrls -%}
  <url>
    <loc>https://lmshandling.com/blog/category/{{ cat.slug }}</loc>
    <lastmod>{{ collections.blogMeta.maxDateModifiedByCategory[cat.slug] }}</lastmod>
    <changefreq>{{ cat.changefreq }}</changefreq>
    <priority>{{ cat.priority }}</priority>
  </url>
  {% endfor %}
