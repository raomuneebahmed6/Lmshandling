# ── Nibaha Haq / lmshandling.com ──

Options -Indexes
ServerSignature Off

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www (canonical domain is lmshandling.com)
RewriteCond %{HTTP_HOST} ^www\.lmshandling\.com$ [NC]
RewriteRule ^(.*)$ https://lmshandling.com/$1 [L,R=301]

# Redirect renamed PDF Store page to its new VU Notes URL
RewriteRule ^store/?$ /vu-notes [R=301,L,NC]

# Remove .html extension from URLs
# If file exists with .html, serve it without showing .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^.]+)$ $1.html [NC,L]

# Redirect .html URLs to clean URLs (removes .html permanently)
RewriteCond %{THE_REQUEST} \.html[\ ?] [NC]
RewriteRule ^(.+)\.html$ /$1 [NC,L,R=301]

# Correct MIME types
AddType text/html .html
AddType image/jpeg .jpg .jpeg
AddType image/png .png
AddType image/x-icon .ico
AddType application/manifest+json .webmanifest
AddType text/css .css
AddType application/javascript .js

# Caching for speed
# HTML is intentionally NOT cached long — this site's CSS/JS live inline
# inside the HTML, so caching the page also freezes styling/scripts. A
# long HTML cache here previously made updates invisible to returning
# visitors for up to a week.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 3 months"
  ExpiresByType image/png "access plus 3 months"
  ExpiresByType image/x-icon "access plus 3 months"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options nosniff
  Header always set X-Frame-Options SAMEORIGIN
  Header always set Referrer-Policy strict-origin-when-cross-origin
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://region1.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://static.cloudflareinsights.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# Block access to sensitive/hidden files (source control, env files, backups)
<FilesMatch "^\.(git|env|htaccess|htpasswd)|\.(bak|sql|log|zip|tar|gz)$">
  Require all denied
</FilesMatch>

# Block a curated list of known aggressive scrapers / vulnerability scanners.
# Legitimate search and AI crawlers (Googlebot, Bingbot, GPTBot, ClaudeBot,
# PerplexityBot, facebookexternalhit, WhatsApp) are intentionally not blocked,
# since this site wants them crawling for SEO/AEO.
RewriteCond %{HTTP_USER_AGENT} (SemrushBot|AhrefsBot|MJ12bot|DotBot|PetalBot|Bytespider|python-requests|Go-http-client|libwww-perl|masscan|Nikto|sqlmap|Nmap) [NC]
RewriteRule .* - [F,L]

# Custom error pages (optional)
ErrorDocument 404 /
