# PostgreSQL connection string.
# For production, create a free database at https://neon.tech or https://supabase.com
# and paste its connection string here (and in Vercel's Environment Variables).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret used to sign login sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Base URL of the deployed site (used by auth). Set to your Vercel URL in production.
NEXTAUTH_URL="http://localhost:3000"
